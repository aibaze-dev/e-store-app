VITE_CONVEX_URL=https://capable-gnu-944.convex.cloud
VITE_CONVEX_SITE_URL=https://capable-gnu-944.convex.site
VITE_SITE_URL=https://capable-gnu-944.convex.site

# Stripe (publishable key, visible in the browser). Without it checkout stays blocked.
VITE_STRIPE_PUBLISHABLE_KEY=

# Convex variables (set with `npx convex env set`, never in this file):
# ATENEO_AUTH_PREVIEW_ORIGIN, ATENEO_AUTH_PREVIEW_EXPIRES_AT: optional exact preview origin
# and expiration timestamp in milliseconds. Set both only when enabling a temporary auth preview.
# AUTH_SIGNUP_ENABLED  leave unset (sign-up closed). Set to "true" only while creating an account.
# ADMIN_ALLOWED_IPS  optional, comma-separated IPs/CIDR ranges that see the login and may sign in.
# STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET  payments and the signed webhook.
# RESEND_API_KEY, EMAIL_FROM  delivery email to buyers; EMAIL_REPLY_TO optional.
# DISCORD_SALE_BOT_URL  optional, Discord webhook that gets an alert for every paid sale.
# OPENAI_API_KEY  enables the landing/quiz text and quiz image assistants.
# OPENAI_MODEL    optional, overrides the default text model.
# OPENAI_IMAGE_MODEL optional, quiz image model (default gpt-image-2.6-flare).
# ANALYTICS_IP_SECRET optional, stable server-only key for IP pseudonyms.
# Defaults to BETTER_AUTH_SECRET with a separate analytics namespace. Never expose as VITE_*.
